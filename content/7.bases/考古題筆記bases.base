filters:
  and:
    - category.contains(link("Exam notes"))
views:
  - type: table
    name: 全部考古題
    filters:
      and:
        - '!file.inFolder("5.templates")'
        - and:
            - '!file.inFolder("5.templates-for-web")'
    order:
      - file.name
      - date
      - 最新測驗得分
      - 科目
      - tags
      - 考題年分
      - 高考普考特考
    sort:
      - property: 考題年分
        direction: ASC
      - property: file.name
        direction: ASC
      - property: file.tags
        direction: ASC
    columnSize:
      file.name: 153
      note.最新測驗得分: 117
      note.科目: 107
      note.考題年分: 88
      note.高考普考特考: 118
