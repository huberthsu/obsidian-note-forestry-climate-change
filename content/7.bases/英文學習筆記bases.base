filters:
  and:
    - category.contains(link("English learning notes"))
    - '!file.inFolder("5.templates-for-web")'
    - '!file.inFolder("5.templates")'
views:
  - type: table
    name: 單字bases
    filters:
      and:
        - category.contains("單字")
    order:
      - file.name
      - Chinese translation
  - type: table
    name: 片語bases
    filters:
      and:
        - category.contains("片語")
    order:
      - file.name
      - Chinese translation
