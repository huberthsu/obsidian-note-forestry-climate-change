filters:
  and:
    - category.contains(link("English learning notes", "英文學習筆記"))
    - and:
        - '!file.inFolder("5.templates")'
        - and:
            - '!file.inFolder("5.templates-for-web")'
views:
  - type: table
    name: 表格
    order:
      - file.name
      - Chinese translation
      - tags
