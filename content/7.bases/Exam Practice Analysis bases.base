filters:
  and:
    - file.inFolder("2.personal-notes/exam-notes")
    - file.ext == "md"
    - file.name != "index"
formulas:
  priority_label: if(note["熟悉度評級"] == "不熟", "1 🔴 不熟", if(note["熟悉度評級"] == "不太熟", "2 🟡 不太熟", if(note["熟悉度評級"] == "熟練", "3 🟢 熟練", "4 🔵 待評估")))
  subject_count: if(file.size > 0, 1, 0)
  answer_status: if(note["參考答案完成日期"], "已完成", "未完成")
properties:
  考題年分:
    displayName: 年份
  科目:
    displayName: 科目
  高考普考特考:
    displayName: 考試等級
  最新測驗得分:
    displayName: 測驗得分
  已練習次數:
    displayName: 練習次數
  熟悉度評級:
    displayName: 熟悉度
  formula.priority_label:
    displayName: 熟悉度
  formula.answer_status:
    displayName: 參考答案
  參考答案完成日期:
    displayName: 參考答案完成日期
views:
  - type: table
    name: 按年分
    groupBy:
      property: 考題年分
      direction: DESC
    order:
      - file.name
      - title
      - 科目
      - tags
      - 最新測驗得分
      - 熟悉度評級
      - 已練習次數
      - date
      - 下次複習時間
    sort: []
    limit: 200
    columnSize:
      note.科目: 202
      note.熟悉度評級: 79
  - type: table
    name: 🎯 按熟悉度
    groupBy:
      property: formula.priority_label
      direction: ASC
    order:
      - file.name
      - title
      - 科目
      - 考題年分
      - tags
      - 最新測驗得分
      - 已練習次數
      - date
      - 下次複習時間
    sort:
      - property: 最新測驗得分
        direction: ASC
      - property: 已練習次數
        direction: ASC
    limit: 200
  - type: table
    name: 📊按科目
    groupBy:
      property: 科目
      direction: ASC
    order:
      - file.name
      - title
      - 考題年分
      - tags
      - 最新測驗得分
      - 熟悉度評級
      - date
      - 下次複習時間
    sort:
      - property: 考題年分
        direction: DESC
    limit: 200
    summaries:
      formula.subject_count: Unique
  - type: calendar
    name: 複習月曆
    order:
      - file.name
      - tags
    startDate: note.下次複習時間
  - type: kanban
    name: 參考答案是否完成
    groupBy:
      property: formula.answer_status
      direction: DESC
    groupOrder:
      - 已完成
      - 未完成
    order:
      - title
      - file.name
      - 科目
      - tags
    sort:
      - property: 考題年分
        direction: DESC
