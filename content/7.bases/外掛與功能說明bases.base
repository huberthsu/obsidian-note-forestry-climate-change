filters:
  and:
    - category.contains(link("Explanation notes"))
views:
  - type: table
    name: 外掛與功能說明筆記
    filters:
      and:
        - category.contains("Plugin and features")
        - and:
            - '!file.inFolder("5.templates")'
            - and:
                - '!file.inFolder("5.templates-for-web")'
    order:
      - file.name
      - tags
      - parent
      - sibling
      - child
