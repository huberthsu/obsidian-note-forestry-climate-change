filters:
  and:
    - category.contains(link("English learning notes"))
    - '!file.inFolder("5.templates-for-web")'
    - '!file.inFolder("5.templates")'
views:
  - type: table
    name: 單字bases
    filters:
      and:
        - category.contains("單字")
    order:
      - file.name
      - Chinese translation
      - 字根
  - type: table
    name: 片語bases
    filters:
      and:
        - category.contains("片語")
    order:
      - file.name
      - Chinese translation
  - type: cards
    name: 字根
    filters:
      and:
        - category.contains("單字")
    groupBy:
      property: 字根
      direction: ASC
    order:
      - file.name
      - Chinese translation
