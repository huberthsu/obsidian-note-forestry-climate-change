filters:
  and:
    - file.inFolder("2.個人note/說明筆記")
views:
  - type: table
    name: 工作流與系統說明筆記
    filters:
      and:
        - and:
            - '!file.inFolder("5.模板")'
            - and:
                - 類別.contains("工作流與系統")
  - type: table
    name: 外掛與功能筆記
    filters:
      and:
        - '!file.inFolder("5.模板")'
        - and:
            - 類別.contains("外掛與功能")
